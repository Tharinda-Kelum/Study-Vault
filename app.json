{
  "expo": {
    "name": "StudyVault",
    "slug": "studyvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.studyvault.offline"
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
